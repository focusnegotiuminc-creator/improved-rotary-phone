{
  "version": 2,
  "framework": null,
  "buildCommand": "echo 'Static Focus Master OS fallback build'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/health", "destination": "/api/focus-connector-health" },
    { "source": "/github/upload-binary", "destination": "/api/focus-connector-upload-binary" },
    { "source": "/github/delete-file", "destination": "/api/focus-connector-delete-file" },
    { "source": "/github/merge-pr", "destination": "/api/focus-connector-merge-pr" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Focus-Deployment", "value": "vercel-fallback" }] }
  ]
}
